# Filled in automatically when you add Neon from the Vercel Marketplace.
DATABASE_URL=

# Password for /admin. Pick something long; anyone with it can edit scores.
ADMIN_PASSWORD=

# Random string; Vercel Cron sends it to /api/sync. Generate with: openssl rand -hex 32
CRON_SECRET=

# Only needed if the ESPN league is ever made private again.
ESPN_S2=
ESPN_SWID=
